{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },


    "ConnectionStrings": {
        "MainDbConString": "Data Source=PDSTUDIO\\SQLEXPRESS2022;Initial Catalog=Movimenti;Integrated Securityu=False;User ID=ApiClient;Password=123_Stella;Trusted_Connection=true;Encrypt=false",
        "MainDbConStringReader": "Data Source=PDSTUDIO\\SQLEXPRESS2022;Initial Catalog=Movimenti;Integrated Securityu=False;User ID=ApiClientReader;Password=123_Stella;Trusted_Connection=true;Encrypt=false",
        "LogsDbConString": "Data Source=PDSTUDIO\\SQLEXPRESS2022;Initial Catalog=MovimentiLogs;Integrated Securityu=False;User ID=ApiClientLog;Password=123_Stella;Trusted_Connection=true;Encrypt=false"
    },

    "RabbitMQ": {
        "Uri": "amqp://myuser:mypassword@localhost:5672",
        "HostName": "localhost",
        "UserName": "myuser",
        "Password": "mypassword",
        "Port": 5672,
        "VirtualHost": "/"
    },

    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Information",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.Hosting.Lifetime": "Warning"
            }
        },
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId",
            "WithProcessId",
            "WithEnvironmentName",
            "WithExceptionDetails"
        ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] [{Application}] {Message:lj}{NewLine}{Exception}",
                    "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day",
                    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{Application}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.json",
                    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
                    "rollingInterval": "Day"
                }
            },
            {
                "Name": "MSSqlServer",
                "Args": {
                    "connectionString": "LogsDbConString",
                    "sinkOptionsSection": {
                        "tableName": "Logs",
                        "schemaName": "dbo",
                        "autoCreateSqlTable": true
                    },
                    "restrictedToMinimumLevel": "Information"
                }
            }
        ]
    }

}
